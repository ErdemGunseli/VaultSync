# =============================================================================
# vault-bridge secret file - one per vault.  Filename IS the enablement.
# =============================================================================
# Mount at $SECRETS_DIR/vault-<name>.env (default /etc/secrets). The <name> part
# becomes VAULT_NAME, so this file defines the vault "planning". There is no
# manifest and no `enabled` flag: the file existing is what turns the vault on.
#
# On Render this is a Secret File. Never commit a real one.
# =============================================================================

# --- git: the source of truth ------------------------------------------------
# PREFERRED: a tokenless URL here plus ONE service-level env var GIT_TOKEN (a
# fine-grained PAT covering your vault repos, Contents: read/write). The daemon
# composes them, so this file holds no credential and rotating the PAT is one
# dashboard edit for every vault at once.
# (A https://<token>@... URL still works and wins over GIT_TOKEN if present.)
VAULT_REPO=https://github.com/<owner>/<vault-repo>.git
VAULT_BRANCH=main

# --- Obsidian Sync: the device bus -------------------------------------------
# PREFERRED auth. `ob` reads OBSIDIAN_AUTH_TOKEN from the environment directly,
# so no login runs at boot and account MFA never blocks the worker.
# Get it by running `ob login` once on any machine, then reading
# $XDG_CONFIG_HOME/obsidian-headless/auth_token (~/.config/... by default).
OBSIDIAN_AUTH_TOKEN=

# Fallback only. Cannot work if the account has MFA enabled.
# OBSIDIAN_EMAIL=
# OBSIDIAN_PASSWORD=

# Remote vault name or id, exactly as `ob sync-list-remote` reports it.
VAULT_SYNC_REMOTE=

# REQUIRED when the remote vault is end-to-end encrypted. If it is encrypted and
# this is unset, `ob sync-setup` prompts for it - which hangs a headless worker.
VAULT_SYNC_ENCRYPTION_PASSWORD=

# Optional: which Obsidian config categories Sync should carry. Comma-separated
# from: app, appearance, appearance-data, hotkey, core-plugin, core-plugin-data,
# community-plugin, community-plugin-data
# VAULT_SYNC_CONFIGS=app,appearance,core-plugin,community-plugin

# --- misc --------------------------------------------------------------------
# Local edits are picked up by inotify within ~1-2s (falls back to polling,
# with a WARNING, if inotify-tools isn't available at runtime). Remote pulls
# poll adaptively: fast while there's recent activity, backing off when idle.
# VAULT_POLL_ACTIVE=2
# VAULT_POLL_IDLE=30
# VAULT_ACTIVE_WINDOW=300

# LEGACY: if set, pins BOTH the active and idle remote-poll rate to this one
# fixed value (the old fixed-interval behaviour). Does not affect the inotify
# local-edit fast path.
# VAULT_BRIDGE_INTERVAL=15

# Obsidian Sync (Standard plan) refuses files over 5MB, so one committed via
# git would reach this repo but never reach a device. Files staged above this
# size are unstaged (not committed) each pass, with a WARNING. 0 disables.
# VAULT_MAX_FILE_MB=5

# VAULT_DEVICE_NAME=vault-bridge-planning
# GIT_AUTHOR_NAME=vault-bridge
# GIT_AUTHOR_EMAIL=vault-bridge@localhost
